# Django
DJANGO_SECRET_KEY=change-me-to-a-secure-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# For production, enable HTTPS and configure the proxy header only when a
# trusted reverse proxy overwrites X-Forwarded-Proto:
# DJANGO_DEBUG=False
# DJANGO_SECURE_PROXY_SSL_HEADER=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# Enable HSTS subdomains/preload only after confirming every subdomain uses HTTPS.
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# If a trusted proxy overwrites this header, use it for client-IP rate limits:
