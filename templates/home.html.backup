{% extends "base.html" %}
{% load static %}
{% block title %}آکادمی حسین طاهری{% endblock %}
{% block head %}
<link href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.js"></script>
<style>
  @layer base {
    /* کانتینر اصلی اسلایدر و ایجاد فضا برای نقطه‌ها در پایین */
    .one-keen-slider-container {
      position: relative;
      width: 100%;
      margin: 0 auto;
      padding-bottom: 40px;
    }

    /* گرد کردن حاشیه‌های بنرها و حل مشکل پرش تصویر */
    .keen-slider__slide {
      border-radius: 24px;
      overflow: hidden;
      background-color: #00244a;
      transition: opacity 0.3s ease;
    }

    /* کمرنگ‌تر کردن اسلایدهای کناری */
    .keen-slider__slide:not(.one-slide-active) {
      opacity: 0.6;
    }

    .one-keen-slide-image {
      width: 100%;
      height: auto;
      object-fit: cover;
      display: block;
    }

    /* جانمایی دکمه‌های فلش در گوشه پایین سمت راست بنر فعال */
    .one-slider-arrows-wrapper {
      position: absolute;
      bottom: 60px;
      right: 40px;
      display: flex;
      gap: 8px;
      z-index: 10;
    }

    /* استایل دکمه‌های فلش با پس‌زمینه شیشه‌ای تیره */
    .one-arrow {
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 8px;
      color: white;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-center;
      cursor: pointer;
      backdrop-filter: blur(4px);
      transition: background 0.2s ease;
    }

    .one-arrow:hover {
      background: rgba(0, 0, 0, 0.7);
    }

    /* جانمایی نقاط راهنما (Dots) در وسط و پایین کانتینر */
    .one-slider-dots {
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      align-items: center;
    }

    /* استایل نقاط راهنمای غیرفعال (دایره‌ای) */
    .one-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #d1d5db;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      padding: 0;
    }

    /* استایل نقطه فعال (خط تیره و پهن‌تر) */
    .one-dot.one-dot-active {
      width: 24px;
      border-radius: 4px;
      background-color: #9ca3af;
    }
  }

  #one-slider-f104e3e-container {
    position: relative;
    overflow: hidden;
  }

  #one-slider-f104e3e {
    display: flex;
    width: 100%;
    transition: transform 0.6s ease-in-out;
    direction: ltr;
  }

  #one-slider-f104e3e .keen-slider__slide {
    flex: 0 0 100%;
    min-width: 100%;
  }

  #one-slider-f104e3e .one-keen-slide-image {
    display: block;
    width: 100%;
    height: auto;
  }

  #one-slider-f104e3e-container .one-dot-active {
    opacity: 1;
  }
</style>
{% endblock %}
{% block content %}
<main class="w-full pt-[132px] bg-background min-h-screen">
  <div class="flex flex-col w-full">
    <!-- 1. HERO SECTION (3-Piece Layout Slider) -->
    <section class="w-full max-w-7xl mx-auto px-margin pt-8 pb-space-lg">
      <div class="elementor-widget-container">
        <div class="one-keen-slider-container" id="one-slider-f104e3e-container">
          <div id="one-slider-f104e3e" class="keen-slider">
            <!-- اسلاید اول -->
            <div class="keen-slider__slide one-slide-item one-slide-active">
              <a href="https://hosseintaheri.ir/pt/ch/">
                <picture>
                  <source media="(max-width: 767px)" srcset="https://hosseintaheri.ir/wp-content/uploads/2026/09/Banner-Web-Decsktop-1000x1000px-Charisma.webp" />
                  <img class="one-keen-slide-image" src="https://hosseintaheri.ir/wp-content/uploads/2026/09/Banner-Web-Decsktop-2000x600-2.webp" alt="کاریزما" loading="lazy" />
                </picture>
              </a>
            </div>
            <!-- اسلاید دوم -->
            <div class="keen-slider__slide one-slide-item">
              <a href="https://hosseintaheri.ir/product/bmbook/">
                <picture>
                  <source media="(max-width: 767px)" srcset="https://hosseintaheri.ir/wp-content/uploads/2026/05/بنر-کتاب-بیزنس-مستری-سایز-موبایلcopy.webp" />
                  <img class="one-keen-slide-image" src="https://hosseintaheri.ir/wp-content/uploads/2026/06/بنر-بیزنس-مستری-صفحه-اصلی-1.webp" alt="بیزنس مستری" loading="lazy" />
                </picture>
              </a>
            </div>
            <!-- اسلاید سوم -->
            <div class="keen-slider__slide one-slide-item">
              <a href="https://hosseintaheri.ir/pt/b360/">
                <picture>
                  <source media="(max-width: 767px)" srcset="https://hosseintaheri.ir/wp-content/uploads/2026/05/بنر-اسلایدر-سایز-موبایل-1080در1080-دوره-طبیزنس360.webp" />
                  <img class="one-keen-slide-image" src="https://hosseintaheri.ir/wp-content/uploads/2026/06/360-new-02.jpg" alt="بیزنس 360" loading="lazy" />
                </picture>
              </a>
            </div>
          </div>

          <!-- دکمه‌های ناوبری روی بنر -->
          <div class="one-slider-arrows-wrapper">
            <button class="one-arrow one-arrow-next">
              <span class="material-symbols-outlined text-[18px]">chevron_right</span>
            </button>
            <button class="one-arrow one-arrow-prev">
              <span class="material-symbols-outlined text-[18px]">chevron_left</span>
            </button>
          </div>

          <!-- نقاط راهنما در زیر بنر -->
          <div class="one-slider-dots">
            <button class="one-dot one-dot-active" aria-label="Slide 1"></button>
            <button class="one-dot" aria-label="Slide 2"></button>
            <button class="one-dot" aria-label="Slide 3"></button>
          </div>
        </div>
      </div>
    </section>

    <!-- محتوای بقیه صفحه home.html در اینجا ادامه می‌یابد -->
    <!-- برای کوتاه کردن، فقط بخش اول را نشان می‌دهم -->
    <!-- شما باید بقیه محتوای فایل home.html اصلی را اینجا کپی کنید -->

  </div>
</main>
{% endblock %}

{% block scripts %}
<script>
  /* =========================================
  1. تنظیمات کاروسل بنر اصلی (Keen Slider)
  ========================================= */
  const sliderElement = document.getElementById("one-slider-f104e3e");
  const sliderContainer = document.getElementById("one-slider-f104e3e-container");
  const dots = document.querySelectorAll(".one-slider-dots .one-dot");
  const arrowNext = document.querySelector(".one-arrow-next");
  const arrowPrev = document.querySelector(".one-arrow-prev");

  if (sliderElement && typeof KeenSlider !== "undefined") {
    const keenSlider = new KeenSlider(sliderElement, {
      loop: true,
      slides: {
        origin: "center",
        perView: 1.15,
        spacing: 24,
      },
      breakpoints: {
        "(max-width: 1024px)": { slides: { perView: 1.3, spacing: 15 } },
        "(max-width: 768px)": { slides: { perView: 1.1, spacing: 10 } },
      },
      created(slider) {
        let interval;
        const startAutoplay = () => {
          interval = setInterval(() => {
            slider.next();
          }, 5000);
        };
        startAutoplay();

        sliderContainer.addEventListener("mouseover", () => clearInterval(interval));
        sliderContainer.addEventListener("mouseout", startAutoplay);
      },
      detailsChanged(slider) {
        const current = slider.track.details.rel;

        dots.forEach((dot, idx) => {
          if (idx === current) {
            dot.classList.add("one-dot-active");
          } else {
            dot.classList.remove("one-dot-active");
          }
        });

        slider.slides.forEach((slide, idx) => {
          if (idx === slider.track.details.rel) {
            slide.classList.add("one-slide-active");
          } else {
            slide.classList.remove("one-slide-active");
          }
        });
      },
    });

    if (arrowNext) arrowNext.addEventListener("click", () => keenSlider.next());
    if (arrowPrev) arrowPrev.addEventListener("click", () => keenSlider.prev());

    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => {
        keenSlider.moveToIdx(idx);
      });
    });
  }
</script>
{% endblock %}